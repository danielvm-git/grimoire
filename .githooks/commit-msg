#!/usr/bin/env bash
# commit-msg: enforce Conventional Commits format
# format: <type>(<optional scope>): <description>
set -euo pipefail

msg_file="$1"
msg="$(head -n 1 "$msg_file")"

# Allow release commits or merge commits
if [[ "$msg" =~ ^Merge.* ]] || [[ "$msg" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?!?: .+$'

if ! [[ "$msg" =~ $pattern ]]; then
  echo "commit-msg: Invalid commit message format." >&2
  echo "Expected Conventional Commits: <type>(<optional scope>): <description>" >&2
  echo "Got: $msg" >&2
  exit 1
fi

# Reject AI attribution co-authored lines
if grep -qiE "co-authored-by:.*(claude|gemini|copilot|ai|chatgpt|openai)" "$msg_file"; then
  echo "commit-msg: AI attribution footer detected. Attribution to AI agents is forbidden." >&2
  exit 1
fi

exit 0
